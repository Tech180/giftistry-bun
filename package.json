{
  "name": "giftistry-api",
  "version": "0.0.28",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "cd ../theming-engine && bun run build",
    "dev": "bun --hot src/index.ts",
    "dev:worker": "GIFTISTRY_PROCESS_ROLE=worker bun --hot src/worker.ts",
    "prestart": "cd ../theming-engine && bun run build",
    "start": "NODE_ENV=production bun src/index.ts",
    "worker": "GIFTISTRY_PROCESS_ROLE=worker bun src/worker.ts",
    "pretest": "bun run scripts/ensure-test-database.ts",
    "test": "bun test --parallel=1",
    "check:sql": "bun run scripts/check-sql-imports.ts",
    "check:layers": "STRICT_MODULES=1 bun run scripts/check-layers.ts",
    "check:contracts": "STRICT=1 bun run scripts/check-contracts.ts",
    "verify": "bun run check:sql && bun run check:layers && bun run check:contracts && bun test --parallel=1",
    "reset-database": "bun run scripts/reset-database.ts",
    "giftistry-admin": "bun run scripts/giftistry-admin.ts",
    "collections:generate": "NODE_ENV=test bun collections/generate-httpie-collection.ts",
    "dev:all": "concurrently \"bun run dev\" \"cd ../giftistry-react && npm start\"",
    "postinstall": "bunx playwright install chromium"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@simplewebauthn/server": "^13.3.2",
    "cheerio": "^1.0.0",
    "elysia": "^1.4.28",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.1.0",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.1",
    "openid-client": "^6.8.4",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.50.0",
    "postgres": "^3.4.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1"
  }
}
